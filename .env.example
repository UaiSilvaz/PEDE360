# PostgreSQL externo. O comando npm run db:local gera credenciais locais aleatórias.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/menuflow"
APP_URL="http://localhost:3000"

# 32 bytes aleatórios em base64. Nunca reutilizar uma chave de exemplo.
ENCRYPTION_KEY=""

# Desenvolvimento: deixe TODOS vazios para storage local.
# Produção: configure todos, com domínio público HTTPS.
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""

# Meta oficial: obtenha os valores no painel do seu aplicativo.
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
META_GRAPH_API_VERSION=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Token aleatório para POST /api/internal/notifications.
CRON_SECRET=""

# Opcionais: usuário inicial da loja demo. Sem senha padrão.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""

